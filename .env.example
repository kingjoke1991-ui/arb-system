# ============ Global ============
APP_NAME=arb-system
ENV=dev
# dry-run | paper-trade | live
MODE=paper-trade
TIMEZONE=UTC
LOG_LEVEL=INFO

# ============ API / Auth ============
# Simple shared-secret token required for /control/* and /config/* POST endpoints
ADMIN_API_TOKEN=change-me-please

# ============ Database / Cache ============
POSTGRES_DSN=postgresql+asyncpg://arb:arb@postgres:5432/arb
REDIS_URL=redis://redis:6379/0

# ============ Exchanges (9 spot) ============
# Leave blank to use public market data only. Credentials required only
# for live trading. Passphrase required on: OKX, KuCoin, Bitget, Coinbase.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=false

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_SANDBOX=false

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_SANDBOX=false

GATE_API_KEY=
GATE_API_SECRET=
GATE_SANDBOX=false

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
KUCOIN_SANDBOX=false

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_SANDBOX=false

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_SANDBOX=false

COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=
COINBASE_SANDBOX=false

HTX_API_KEY=
HTX_API_SECRET=
HTX_SANDBOX=false

# ============ Perpetual-futures keys (FundingExecutor, live only) ============
# Kept distinct from spot for least-privilege. Kraken/Coinbase perp NOT
# supported (classic spot-only via ccxt).
BINANCE_PERP_API_KEY=
BINANCE_PERP_API_SECRET=
OKX_PERP_API_KEY=
OKX_PERP_API_SECRET=
OKX_PERP_PASSPHRASE=
BYBIT_PERP_API_KEY=
BYBIT_PERP_API_SECRET=
GATE_PERP_API_KEY=
GATE_PERP_API_SECRET=
KUCOIN_PERP_API_KEY=
KUCOIN_PERP_API_SECRET=
KUCOIN_PERP_PASSPHRASE=
BITGET_PERP_API_KEY=
BITGET_PERP_API_SECRET=
BITGET_PERP_PASSPHRASE=
HTX_PERP_API_KEY=
HTX_PERP_API_SECRET=

# ============ Trading ============
# Symbol tiers (final enabled_symbols = union of enabled tiers when blank).
SYMBOL_TIER1=BTC/USDT,ETH/USDT,SOL/USDT
SYMBOL_TIER2=DOGE/USDT,ARB/USDT,OP/USDT,SUI/USDT,WIF/USDT,XRP/USDT,LINK/USDT,ADA/USDT
SYMBOL_TIER3=PEPE/USDT,SHIB/USDT,BONK/USDT,FLOKI/USDT,JTO/USDT,TIA/USDT,ORDI/USDT
SYMBOL_TIER1_ENABLED=true
SYMBOL_TIER2_ENABLED=true
SYMBOL_TIER3_ENABLED=true
# Legacy override. Empty = use tiers above.
ENABLED_SYMBOLS=
MIN_NET_EDGE_BPS=3
MIN_PROFIT_QUOTE=0.1
# Liquidity filter: reject opportunities with <N USDT fillable depth.
MIN_LIQUIDITY_USDT=20.0
MIN_ORDER_SIZE_QUOTE=10.0
MAX_NOTIONAL_PER_TRADE=50.0
COOLDOWN_SECONDS=5
SCAN_INTERVAL_MS=200

# ============ Risk ============
MAX_EXPOSURE_PER_EXCHANGE=500.0
MAX_TOTAL_OPEN_HEDGES=3
MAX_REPAIR_ATTEMPTS=3
MAX_CONSECUTIVE_FAILURES=5
MAX_MARKETDATA_STALENESS_MS=3000
MAX_BALANCE_STALENESS_SEC=60
KILL_SWITCH=false

# ============ Execution ============
# limit | market | ioc_limit | fok_limit
ORDER_TYPE_POLICY=ioc_limit
IOC_PRICE_BUFFER_BPS=3
CANCEL_TIMEOUT_MS=2000
ORDER_STATUS_POLL_MS=500

# ============ Monitoring ============
METRICS_ENABLED=true
ALERT_WEBHOOK=
ALERT_MIN_SEVERITY=warning
